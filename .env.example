# ============================================
# 🔧 TELEGRAM API SOZLAMALARI
# https://my.telegram.org/apps dan oling
# ============================================
API_ID=123456
API_HASH=your_api_hash_here

# ============================================
# 🤖 BOSHQARUV BOTI
# @BotFather dan oling
# ============================================
BOT_TOKEN=123456789:AAExampleBotTokenHere

# Botni faqat shu username boshqarsin (✏️ @ belgisiz yozing)
OWNER_USERNAME=your_username

# ============================================
# 🔐 LOGIN HAQIDA MUHIM:
# Telefon raqam, SMS kod va (agar bor bo'lsa) 2FA parol ENDI TERMINALDA
# SO'RALMAYDI — bot ishga tushgandan keyin Telegramda boshqaruv botingizga
# /start yuborsangiz, hammasi O'SHA YERDA (bot chatida) so'raladi.
# ============================================

# ============================================
# 💾 SESSION_STRING (ixtiyoriy, lekin DEPLOY uchun TAVSIYA ETILADI)
# Birinchi muvaffaqiyatli login qilingandan keyin bot sizga shu qiymatni
# Telegram orqali yuboradi. Uni shu yerga (yoki hosting platformangizning
# Environment Variables bo'limiga) joylashtirsangiz, keyingi safar bot
# umuman login so'ramasdan to'g'ridan-to'g'ri ulanadi — fayl tizimi
# tozalansa (qayta deploy) ham muammo bo'lmaydi.
# ============================================
SESSION_STRING=
